{
  "servers": {
    "local": {
      "enabled": true,
      "required": true,
      "transport": "stdio",
      "command": "${PYTHON}",
      "args": [
        "${AGENT_DIR}/mcp_server.py"
      ],
      "env": {
        "MCP_ROOT": "${WORKSPACE}"
      },
      "timeout_s": 300,
      "startup_timeout_s": 15
    },
    "freecad": {
      "enabled": true,
      "required": false,
      "transport": "stdio",
      "command": "uvx",
      "args": [
        "freecad-mcp",
        "--only-text-feedback"
      ],
      "timeout_s": 180,
      "startup_timeout_s": 60,
      "read_only_tools": [
        "list_documents",
        "get_objects",
        "get_object",
        "get_view",
        "get_rpc_status",
        "get_parts_list",
        "get_async_status"
      ]
    },
    "openai_vision": {
      "enabled": true,
      "required": false,
      "transport": "stdio",
      "command": "${PYTHON}",
      "args": [
        "${AGENT_DIR}/mcp_openai_vision.py"
      ],
      "env": {
        "MCP_VISION_ROOT": "${WORKSPACE}"
      },
      "timeout_s": 120,
      "startup_timeout_s": 15,
      "read_only_tools": [
        "image_info",
        "compare_regions"
      ]
    }
  },
  "automatic_vision": {
    "enabled": true,
    "detail": "high",
    "max_objects": 8,
    "max_calls_per_turn": 4,
    "max_image_bytes": 8388608
  }
}
